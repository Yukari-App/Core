<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Yukari.Core</RootNamespace>

    <PackageId>Yukari.Core</PackageId>
    <Version>2.6.0</Version>
    <Authors>TXG0Fk3</Authors>
    <Description>The API Contract and Data Models for the Yukari Ecosystem.</Description>
    <PackageTags>manga;reader;plugin;core</PackageTags>
    <RepositoryUrl>https://github.com/Yukari-App/Core</RepositoryUrl>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
